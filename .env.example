PORT=3000
HOST=0.0.0.0

# Aplicación Laravel RR. HH. (sin /api al final)
RRHH_API_URL=
RRHH_BOT_CLIENT_SECRET=

# Evolution API
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Opcional: si se define, Evolution debe enviarlo en apikey o x-webhook-secret
WEBHOOK_SECRET=

# Clave que deben enviar los sistemas externos (biométrico) a /api/v1/notifications
# en Authorization: Bearer <clave> o x-api-key. Si está vacía, la API queda deshabilitada.
NOTIFICATIONS_API_KEY=

REQUEST_TIMEOUT_MS=10000
